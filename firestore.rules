rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helper: e-mail está na lista de administradores? ----
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/config/admins).data.emails
             .hasAny([request.auth.token.email.lower()]);
    }

    // ---- lista de administradores ----
    match /config/admins {
      // qualquer autenticado LÊ (o app precisa checar se é admin)
      allow read: if request.auth != null;
      // só admin ALTERA; exceção: bootstrap quando a lista ainda não existe
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---- projetos de cada usuário ----
    match /users/{userId}/projetos/{projetoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- leitura global para o painel executivo (collectionGroup) ----
    match /{path=**}/projetos/{projetoId} {
      allow read: if isAdmin();
    }

    // ---- bloqueia o resto ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
